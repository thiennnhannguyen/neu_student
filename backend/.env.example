# Sao chep thanh backend/.env. Makefile tu nap file nay.
# development | testing | production
APP_CONFIG=development
# Bat buoc khi APP_CONFIG=production.
SECRET_KEY=
# Bo trong de dung SQLite trong backend/instance/.
DATABASE_URL=
# Cong backend khi chay dev; Vite proxy doc cung bien nay.
BACKEND_PORT=5001
